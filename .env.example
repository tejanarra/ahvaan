# Copy to .env.local and fill in with your NEW Supabase project's values
# (this branch is meant to point at a separate project from main).

# Project Settings -> API in the new Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — free tier, needed for Stage 4 (email sending).
# Not required for auth/dashboard/RSVP to work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public origin used to build invite links inside emails (server-side, so
# window.location isn't available). http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# Signs the guest-verification cookie set once a no-invite guest verifies
# their email for an 'email_verified'-mode event (src/lib/guest-session.ts).
# Any long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUEST_SESSION_SECRET=

# No longer used on this branch (replaced by Supabase Auth):
# ADMIN_PASSWORD, SESSION_SECRET
